# Public canonical production URL. Use the real HTTPS domain in deployment.
NEXT_PUBLIC_SITE_URL=https://mudziyo.co.zw

# Server-side destination for validated contact-form enquiries. Do not expose
# credentials or provider API keys in NEXT_PUBLIC_ variables.
CONTACT_FORM_WEBHOOK_URL=

# Enable only when the deployment proxy reliably overwrites x-forwarded-for.
CONTACT_FORM_TRUST_PROXY=false
